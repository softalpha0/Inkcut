# SERV Reasoning (OpenAI-compatible chat completions)
# Get a key at https://console.openserv.ai -> Settings -> API Keys
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_MODEL=gpt-5.4-mini

# Images
IMAGE_PROVIDER=fal            # fal | pollinations (replicate planned for M2)
FAL_KEY=
POLLINATIONS_API_KEY=         # secret sk_ key from enter.pollinations.ai -> Keys
POLLINATIONS_MODEL=black-forest-labs/flux.1-schnell

# Animation (--animate): image-to-video, paid per generated second, paid pollen only.
# The Pollinations key needs the "video" permission and a budget.
ANIMATE_PROVIDER=pollinations
ANIMATE_MODEL=bytedance/seedance-1-pro-fast   # or alibaba/wan-2.2-fast (cheaper, fixed 5 s clips)
ANIMATE_RESOLUTION=480p
REPLICATE_API_TOKEN=

# Speech
TTS_PROVIDER=edge             # edge
STT_PROVIDER=openai           # openai (any OpenAI-compatible /audio/transcriptions endpoint)
STT_API_KEY=                  # only needed for --audio mode
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# Supabase (web + worker): Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # server only: worker and API routes, never the browser
SUPABASE_URL=                  # worker; same value as NEXT_PUBLIC_SUPABASE_URL

# Queue (web + worker): Redis URL, e.g. Render Key Value or Upstash (rediss://...)
REDIS_URL=

# Web
NEXT_PUBLIC_SITE_URL=          # e.g. https://inkcut-web.onrender.com
ADMIN_EMAILS=                  # comma-separated; only these accounts can use paid --animate
WORKER_CONCURRENCY=1           # videos the worker renders at once

# Optional
# FFMPEG_PATH=                # override bundled ffmpeg (e.g. system ffmpeg in Docker)
# FFPROBE_PATH=               # override bundled ffprobe
# INKCUT_OUT_DIR=             # default: <repo>/out
# LOG_FORMAT=json             # default: pretty
